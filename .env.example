VIRUSTOTAL_API_KEY=your_virustotal_key_here
URLSCAN_API_KEY=your_urlscan_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_key_here

# Credenciales (HTTP Basic Auth) que protegen únicamente /api/keys, el
# endpoint que guarda las API keys. El resto de la app (escaneo, UI) queda
# abierto para que cualquiera con el link pueda usarla sin login.
# Si APP_PASSWORD está vacío, /api/keys también queda abierto: cualquiera
# podría sobrescribir tus API keys. Defínelas antes de exponer la app en red o Render.
APP_USERNAME=admin
APP_PASSWORD=
